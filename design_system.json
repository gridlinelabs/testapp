{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "BillSplit AI Design System",
    "version": "1.0.0",
    "description": "Fintech-grade design tokens for BillSplit AI",
    "platform": "Flutter / Android"
  },
  "colors": {
    "primary": {
      "default": "#4F46E5",
      "light": "#818CF8",
      "dark": "#3730A3",
      "surface": "#EEF2FF"
    },
    "accent": {
      "default": "#10B981",
      "light": "#6EE7B7",
      "dark": "#047857",
      "surface": "#ECFDF5"
    },
    "semantic": {
      "success": "#22C55E",
      "error": "#EF4444",
      "warning": "#F59E0B",
      "info": "#3B82F6"
    },
    "neutral": {
      "50": "#F9FAFB",
      "100": "#F3F4F6",
      "200": "#E5E7EB",
      "300": "#D1D5DB",
      "400": "#9CA3AF",
      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1F2937",
      "900": "#111827"
    },
    "financial": {
      "positive": "#22C55E",
      "negative": "#EF4444",
      "neutral": "#6B7280"
    },
    "dark": {
      "background": "#0F172A",
      "surface": "#1E293B",
      "surfaceVariant": "#334155"
    }
  },
  "typography": {
    "fontFamily": "Sora",
    "fallbacks": ["Inter", "SF Pro Display", "system-ui"],
    "scale": {
      "displayLarge": { "size": 57, "weight": 700, "lineHeight": 1.12, "tracking": -0.25 },
      "displayMedium": { "size": 45, "weight": 700, "lineHeight": 1.16, "tracking": 0 },
      "displaySmall": { "size": 36, "weight": 600, "lineHeight": 1.22, "tracking": 0 },
      "headlineLarge": { "size": 32, "weight": 700, "lineHeight": 1.25, "tracking": 0 },
      "headlineMedium": { "size": 28, "weight": 600, "lineHeight": 1.29, "tracking": 0 },
      "headlineSmall": { "size": 24, "weight": 600, "lineHeight": 1.33, "tracking": 0 },
      "titleLarge": { "size": 20, "weight": 600, "lineHeight": 1.27, "tracking": 0 },
      "titleMedium": { "size": 16, "weight": 600, "lineHeight": 1.5, "tracking": 0.15 },
      "titleSmall": { "size": 14, "weight": 600, "lineHeight": 1.43, "tracking": 0.1 },
      "bodyLarge": { "size": 16, "weight": 400, "lineHeight": 1.5, "tracking": 0.5 },
      "bodyMedium": { "size": 14, "weight": 400, "lineHeight": 1.43, "tracking": 0.25 },
      "bodySmall": { "size": 12, "weight": 400, "lineHeight": 1.33, "tracking": 0.4 },
      "labelLarge": { "size": 14, "weight": 500, "lineHeight": 1.43, "tracking": 0.1 },
      "labelMedium": { "size": 12, "weight": 500, "lineHeight": 1.33, "tracking": 0.5 },
      "labelSmall": { "size": 11, "weight": 500, "lineHeight": 1.45, "tracking": 0.5 },
      "amountLarge": { "size": 40, "weight": 700, "lineHeight": 1.1, "tracking": -0.5 },
      "amountMedium": { "size": 24, "weight": 700, "lineHeight": 1.2, "tracking": -0.25 },
      "amountSmall": { "size": 18, "weight": 600, "lineHeight": 1.3, "tracking": 0 }
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "base": 16,
      "lg": 20,
      "xl": 24,
      "2xl": 32,
      "3xl": 40,
      "4xl": 48,
      "5xl": 64,
      "6xl": 80
    }
  },
  "borderRadius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "full": 9999
  },
  "shadows": {
    "xs": "0 1px 2px rgba(0,0,0,0.04)",
    "sm": "0 2px 6px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)",
    "md": "0 4px 12px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.04)",
    "lg": "0 8px 24px rgba(0,0,0,0.10), 0 4px 8px rgba(0,0,0,0.06)",
    "primary": "0 8px 20px rgba(79,70,229,0.25)"
  },
  "components": {
    "button": {
      "height": { "sm": 40, "md": 52, "lg": 60 },
      "radius": 12,
      "labelStyle": "labelLarge"
    },
    "card": {
      "radius": 16,
      "padding": 16,
      "shadow": "sm"
    },
    "input": {
      "radius": 12,
      "padding": { "h": 16, "v": 12 },
      "height": 52
    },
    "avatar": {
      "sm": 32,
      "md": 40,
      "lg": 56
    },
    "bottomNav": {
      "height": 72
    }
  },
  "gradients": {
    "primary": ["#4F46E5", "#7C3AED"],
    "accent": ["#10B981", "#059669"],
    "card": ["#4F46E5", "#4338CA"]
  }
}
