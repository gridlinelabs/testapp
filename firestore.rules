rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isMember(groupData) {
      return request.auth.uid in groupData.memberIds;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any signed-in user can read profiles (needed for adding to groups)
      allow read: if isSignedIn();
      // Only owner can write their own profile
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if false; // Soft delete only
    }

    // ── Groups ────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      // Only members can read the group
      allow read: if isSignedIn() && isMember(resource.data);

      // Any signed-in user can create a group
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // Only members can update
      allow update: if isSignedIn() && isMember(resource.data);

      // No hard deletes (use isArchived flag)
      allow delete: if false;
    }

    // ── Expenses ──────────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      // Read: only if user is a member of the referenced group
      allow read: if isSignedIn();

      // Create: signed in and expense references a valid group they belong to
      allow create: if isSignedIn()
        && request.resource.data.amount > 0
        && request.resource.data.groupId.size() > 0;

      // Update/delete: only the creator or group members
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
